# ==== Database (TimescaleDB) ====
POSTGRES_USER=logwatch
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=logwatch
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
PG_POOL_MAX=20
# PG_SSL=true  # ative se conectar em Patroni com TLS

# ==== Redis ====
REDIS_HOST=redis
REDIS_PORT=6379

# ==== Backend ====
NODE_ENV=production
LOG_LEVEL=info
PORT=4000
JWT_SECRET=change_to_long_random_at_least_32_chars_______
JWT_REFRESH_SECRET=change_too_to_another_random_32_chars________
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CORS_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@logwatch.local
ADMIN_PASSWORD=ChangeMe!123

# Master key para o vault interno (AES-256-GCM).
# Gere com: openssl rand -hex 32
SECRETS_MASTER_KEY=

# ==== Patroni ====
# Lista CSV de nós Patroni REST. Ex: http://pg1:8008,http://pg2:8008,http://pg3:8008
PATRONI_NODES=
# PATRONI_BASIC_AUTH=user:pass

# ==== Ansible Semaphore (opcional) ====
SEMAPHORE_URL=http://semaphore:3000
SEMAPHORE_API_TOKEN=
SEMAPHORE_DB_PASSWORD=semaphore
SEMAPHORE_ADMIN_PASSWORD=ChangeMe!123
SEMAPHORE_ENCRYPTION=changemeplease==

# ==== GitHub (Terraform Control Plane + Pipelines) ====
# Token com escopo `repo` para abrir PRs no Terraform CP. Em produção use GitHub App.
GITHUB_TOKEN=

# ==== Agent (quando rodar via compose --profile agent) ====
# GID do grupo `docker` no host (necessário para o agent não-root ler o socket).
# Descubra com: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Paths que o agent pode listar/ler/escrever/executar (CSV, absolutos)
# Ex: LOGWATCH_ALLOWED_PATHS=/opt/digivox,/etc/nginx,/srv/scripts
LOGWATCH_ALLOWED_PATHS=/opt
LOGWATCH_MAX_READ=5000000
LOGWATCH_MAX_WRITE=5000000
LOGWATCH_EXEC_TIMEOUT=120000

# ==== Frontend ====
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=ws://localhost:4000
