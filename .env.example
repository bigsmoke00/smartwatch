# ==== Database (TimescaleDB) ====
POSTGRES_USER=logwatch
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=logwatch
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
PG_POOL_MAX=20
# PG_SSL=true  # ative se conectar em Patroni com TLS

# ==== Redis ====
REDIS_HOST=redis
REDIS_PORT=6379

# ==== Backend ====
NODE_ENV=production
LOG_LEVEL=info
PORT=4000
JWT_SECRET=change_to_long_random_at_least_32_chars_______
JWT_REFRESH_SECRET=change_too_to_another_random_32_chars________
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CORS_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@logwatch.local
ADMIN_PASSWORD=ChangeMe!123

# Token de uso único para o link de "definir senha" enviado por email.
# Se deixar em branco, cai no JWT_SECRET (não recomendado em produção).
JWT_INVITE_SECRET=change_to_another_long_random_32_chars_____
JWT_INVITE_EXPIRES=3d

# URL pública do frontend, usada para montar o link do email de convite
# (ex.: https://logwatch.smartspace.us). Sem barra no final.
FRONTEND_URL=http://localhost:3000

# ==== Email (AWS SES) ====
# Usado para enviar o convite de "defina sua senha" para usuários novos.
# Se AWS_SES_ACCESS_KEY_ID/SECRET ficarem em branco, usa a credential chain
# padrão da AWS (IAM role da instância/task).
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
MAIL_FROM=no-reply@smartspace.us
MAIL_FROM_NAME=SmartSpace LogWatch

# Limites de ingestao para proteger o banco de streams ruidosos.
# 16384: stack trace agrupado (multi-linha do agent) cabe sem truncar.
# (teto do codigo agora e 64KB; suba aqui se um evento unico passar de 16KB)
LOGWATCH_MAX_MESSAGE_LENGTH=16384
# Tamanho maximo do corpo HTTP aceito no /ingest. O agent lota por bytes ate
# LOGWATCH_MAX_BATCH_BYTES (100MB); isto fica acima, com margem. Se houver
# nginx/proxy na frente, alinhe o client_max_body_size com este valor.
LOGWATCH_INGEST_BODY_LIMIT=150mb
LOGWATCH_MAX_META_BYTES=4096
LOGWATCH_MAX_STORED_ROWS_PER_MINUTE=5000

# VACUUM (FULL, ANALYZE) noturno (3h) da base toda, pra devolver ao SO o
# disco que o DELETE de retencao (logs etc.) deixa "preso" em tuplas mortas.
# Desligado por padrao porque toma lock exclusivo tabela/chunk por tabela/chunk.
LOGWATCH_VACUUM_FULL_ENABLED=false

# Master key para o vault interno (AES-256-GCM).
# Gere com: openssl rand -hex 32
SECRETS_MASTER_KEY=

# ==== Patroni (legado) ====
# Clusters Patroni agora são cadastrados pela tela "Cluster Patroni" no
# frontend (CRUD em /patroni/clusters), não mais por env var.
# Estas variáveis só são usadas uma vez, no primeiro boot do backend, para
# migrar automaticamente um cluster pré-existente para o banco (ver
# BootstrapService.seedLegacyPatroniCluster). Pode deixar em branco em
# instalações novas.
# PATRONI_NODES=http://pg1:8008,http://pg2:8008,http://pg3:8008
# PATRONI_BASIC_AUTH=user:pass

# ==== Ansible Semaphore (opcional) ====
SEMAPHORE_URL=http://semaphore:3000
SEMAPHORE_API_TOKEN=
SEMAPHORE_DB_PASSWORD=semaphore
SEMAPHORE_ADMIN_PASSWORD=ChangeMe!123
SEMAPHORE_ENCRYPTION=changemeplease==

# ==== GitHub (Terraform Control Plane + Pipelines) ====
# Token com escopo `repo` para abrir PRs no Terraform CP. Em produção use GitHub App.
GITHUB_TOKEN=

# ==== Agent (quando rodar via compose --profile agent) ====
# GID do grupo `docker` no host (necessário para o agent não-root ler o socket).
# Descubra com: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Paths que o agent pode listar/ler/escrever/executar (CSV, absolutos)
# Script Manager: caminhos do HOST Linux que o agent pode ler/escrever.
# Use "/" para liberar o host inteiro via bind /:/host.
# Ex restrito: LOGWATCH_ALLOWED_PATHS=/opt/digivox,/etc/nginx,/srv/scripts
LOGWATCH_ALLOWED_PATHS=/
LOGWATCH_MAX_READ=5000000
LOGWATCH_MAX_WRITE=5000000
LOGWATCH_EXEC_TIMEOUT=120000
LOGWATCH_MAX_BUFFER_ENTRIES=5000
LOGWATCH_MAX_LINE_LENGTH=4096
LOGWATCH_MAX_LINES_PER_SOURCE_PER_SECOND=200
# Agrupamento multi-linha (stack traces Java/Logback viram 1 evento, herdando
# o nivel da linha-cabecalho em vez de virar N linhas UNKNOWN). Ligado por
# padrao. LOGWATCH_MULTILINE=false volta ao modo 1 linha = 1 evento (literal).
# IDLE_MS = janela de ociosidade pra fechar o evento; MAX_EVENT_LENGTH = teto
# em chars do evento agrupado (alinhe com LOGWATCH_MAX_MESSAGE_LENGTH do backend).
LOGWATCH_MULTILINE=true
LOGWATCH_MULTILINE_IDLE_MS=500
LOGWATCH_MAX_EVENT_LENGTH=16384
# Teto de bytes por POST de ingest (rede de seguranca; batchSize=200 costuma
# fechar o lote antes). Backend aceita ate LOGWATCH_INGEST_BODY_LIMIT (150MB).
LOGWATCH_MAX_BATCH_BYTES=104857600
# /var/log e opt-in para evitar duplicar ou sobrecarregar logs de containers.
LOGWATCH_HOST_LOG_ENABLED=false
LOGWATCH_HOST_LOG_PATHS=/var/log

# ==== Frontend ====
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=ws://localhost:4000
